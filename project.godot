[layer_names]

2d_physics/layer_1="Pl_Wall"
2d_physics/layer_2="Pl_Player_Body"
2d_physics/layer_3="Pl_Ball"
2d_physics/layer_4="Pl_Ball_Picker"
2d_physics/layer_5="Pl_Hurt_Box"
2d_physics/layer_6="Pl_Hit_Box"

[rendering]

textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

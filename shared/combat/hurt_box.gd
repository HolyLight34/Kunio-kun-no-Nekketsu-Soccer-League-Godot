# ==============================================================================
# HurtBox
# ==============================================================================
#
# 职责：
#   HurtBox 是被动受击检测组件。
#
#   它负责：
#   1. 表示某个对象可以被 HitBox 命中的区域。
#   2. 接收 HitBox 传来的 HitInfo。
#   3. 通过 hit_received 信号将 HitInfo 交给所属对象。
#
#   它不负责：
#   - 解释 HitInfo。
#   - 判断攻击是否合法。
#   - 计算伤害、体力差或击退。
#   - 处理足球轨迹。
#   - 改变 Player / Ball 的状态。
#
# 数据流：
#
#   HitBox
#       ↓ receive_hit()
#   HurtBox
#       ↓ hit_received
#   Player / Ball
#       ↓
#   自己解释 HitInfo
#
# ==============================================================================

class_name HurtBox
extends Area2D


# ==============================================================================
# 配置
# ==============================================================================

## 这个 HurtBox 所属的对象。
##
## 当前主要供 HitBox 判断是否命中了自身。
@export var target: CharacterBody2D


# ==============================================================================
# 信号
# ==============================================================================

## 当 HurtBox 收到一次命中时发送。
##
## HurtBox 不解释 HitInfo，只负责将它继续传递给所属对象。
signal hit_received(hit_info: HitInfo)


# ==============================================================================
# 公共接口
# ==============================================================================

## 接收 HitBox 传来的 HitInfo。
##
## HitInfo 的具体含义由 Player、Ball 等目标对象自己解释。
func receive_hit(hit_info: HitInfo) -> void:
	hit_received.emit(hit_info)
